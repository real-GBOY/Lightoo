# ── App ─────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used to build the Spotify redirect URI.
APP_URL=http://127.0.0.1:3000

# ── Database (Postgres: Neon via the Vercel Marketplace) ────────────
# Pooled URL for the serverless runtime; direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── Owner sign-in (single user) ─────────────────────────────────────
OWNER_EMAIL=you@example.com
# scrypt hash. Generate with:  npx tsx scripts/hash-password.ts "your password"
OWNER_PASSWORD_HASH=
# ≥32 random chars: openssl rand -base64 48
SESSION_SECRET=

# ── Spotify (https://developer.spotify.com/dashboard) ───────────────
SPOTIFY_CLIENT_ID=
# Optional: LIGHTOO uses Authorization Code + PKCE, so no secret is required.
# SPOTIFY_CLIENT_SECRET=
# Must match APP_URL + /api/spotify/callback and be registered in the dashboard.
# Defaults to that value when unset. Spotify requires https or a loopback IP (127.0.0.1).
# SPOTIFY_REDIRECT_URI=

# ── Token encryption at rest (AES-256-GCM) ──────────────────────────
# 32 bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── Cron ────────────────────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/sync.
CRON_SECRET=
